PORT=3000

# Required: model name served by your OpenAI-compatible endpoint.
LLM_MODEL=
# Base URL of the OpenAI-compatible API (Ollama, vLLM, ...). Trailing slash optional.
LLM_BASE_URL=http://localhost:11434/v1
# Optional bearer key. Leave empty for local endpoints like Ollama.
LLM_API_KEY=
# Per-request timeout in ms.
LLM_TIMEOUT_MS=60000
# System prompt used for context construction.
SYSTEM_PROMPT=You are Isabel, a helpful assistant.
# Max stored messages per session (in-memory, lost on restart).
MAX_HISTORY=50
# Label only in Milestone 1; the generic client ignores it.
LLM_PROVIDER=